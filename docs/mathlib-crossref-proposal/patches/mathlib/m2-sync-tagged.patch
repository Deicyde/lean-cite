From 2bb8dad65bcd31dc45a6a287c90ddf0b4730fdd0 Mon Sep 17 00:00:00 2001
From: Jack McCarthy <37917934+Deicyde@users.noreply.github.com>
Date: Fri, 30 Oct 2026 04:28:11 -0400
Subject: [PATCH 2/2] fix(Tactic/CrossRefAttribute): elaborate tagged theorems
 synchronously

Local prototype M2, on top of M1. Removes M1's same-file gap for theorems tagged at their declaration.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 Mathlib/Tactic/CrossRefAttribute.lean | 23 ++++++++++++++++++++++-
 1 file changed, 22 insertions(+), 1 deletion(-)

diff --git a/Mathlib/Tactic/CrossRefAttribute.lean b/Mathlib/Tactic/CrossRefAttribute.lean
index 262ecf56e5..5643363f97 100644
--- a/Mathlib/Tactic/CrossRefAttribute.lean
+++ b/Mathlib/Tactic/CrossRefAttribute.lean
@@ -150,7 +150,8 @@ so the attributes run after compilation. A theorem elaborated in parallel gets i
 parallel branch, after the attributes ran. `modifyState` applies its function both to the state
 visible here and to the final state exported to the `.olean` file, where it runs after the parallel
 branch and so appends the link to the theorem's docstring. The theorem's own file sees that
-docstring without the link.
+docstring without the link, which is why `elabTaggedTheorem` elaborates tagged theorems
+synchronously. Only `attribute [stacks ...] thm` on a theorem declared earlier still has this gap.
 
 A Markdown docstring takes precedence over a Verso one, so a Verso docstring gets a Verso link.
 Whether a theorem elaborated in parallel will get a Verso docstring is not visible here, so
@@ -653,6 +654,26 @@ initialize Lean.registerBuiltinAttribute {
   applicationTime := .afterCompilation
 }
 
+/-! ### Tagged theorems -/
+
+/-- Whether `stx`, a `declaration`, is a theorem with a cross-reference attribute. -/
+def isTaggedTheorem (stx : Syntax) : Bool :=
+  stx[1].isOfKind ``Parser.Command.theorem && stx[0][1].getOptional?.any fun attrs =>
+    attrs[1].getSepArgs.any fun attr =>
+      [``stacksTag, ``wikidataTag, ``lmfdbTag, ``pibaseTag, ``dlmfTag, ``oeisTag].contains
+        attr[1].getKind
+
+/-- Elaborate a theorem with a cross-reference attribute synchronously, so that the attribute sees
+the theorem's docstring and writes to the state that this file reads. See `addCrossRefDoc`.
+
+This falls through for every other declaration, and is `incremental` because otherwise
+`elabCommandUsing` would cancel the previous snapshot of every declaration before trying it. -/
+@[command_elab Lean.Parser.Command.declaration, incremental]
+def elabTaggedTheorem : Command.CommandElab := fun stx => do
+  unless Elab.async.get (← getOptions) && isTaggedTheorem stx do throwUnsupportedSyntax
+  Command.withScope (fun sc => { sc with opts := Elab.async.set sc.opts false }) <|
+    Command.elabCommand stx
+
 end Mathlib.CrossRef
 
 /-- Returns the array of `Tag`s in the environment, sorted alphabetically by tag. -/
-- 
